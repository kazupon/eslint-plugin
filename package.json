{
  "name": "@kazupon/eslint-plugin",
  "description": "ESLint plugin for @kazupon",
  "version": "0.8.3",
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/eslint-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/eslint-plugin.git"
  },
  "keywords": [
    "eslint",
    "lint",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "lib",
    "oxlint"
  ],
  "module": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "lib/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./lib/*",
        "./*"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && pnpm run gen:oxlint:config",
    "clean": "git clean -df",
    "dev": "pnpx @eslint/config-inspector --config eslint.config.ts",
    "dev:eslint": "pnpx @eslint/config-inspector --config eslint.config.ts",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "docs:readme": "tsx scripts/update-readme.ts",
    "docs:rules": "tsx scripts/update-docs.ts",
    "fix": "pnpm run --color \"/^fix:/\"",
    "fix:eslint": "eslint . --fix",
    "fix:knip": "knip --fix --no-exit-code",
    "fix:oxfmt": "oxfmt --config ./node_modules/@kazupon/prettier-config/index.json",
    "fix:oxlint": "oxlint --type-aware --fix",
    "gen:oxlint:config": "tsx ./scripts/generate-oxlint-config.ts",
    "gen:oxlint:dts": "cat ./node_modules/oxlint/configuration_schema.json | json2ts > scripts/oxlint-config.d.ts",
    "lint": "pnpm run --color \"/^lint:/\"",
    "lint:eslint": "eslint . --cache",
    "lint:knip": "knip",
    "lint:oxfmt": "oxfmt . --check --config ./node_modules/@kazupon/prettier-config/index.json",
    "lint:oxlint": "oxlint --type-aware",
    "prepack": "pnpm build",
    "prepare": "git config --local core.hooksPath .githooks && pnpm gen:oxlint:dts",
    "preversion": "tsx scripts/check-release.ts",
    "release": "bumpp",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit --diagnostics"
  },
  "dependencies": {
    "@es-joy/jsdoccomment": "^0.100.0",
    "@eslint/core": "^1.0.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/markdown": "^8.0.0",
    "@kazupon/eslint-config": "^0.45.0",
    "@kazupon/jts-utils": "^0.17.0",
    "@kazupon/prettier-config": "^0.2.0",
    "@shikijs/vitepress-twoslash": "^4.0.0",
    "@types/node": "^26.6.6",
    "@typescript/native-preview": "7.0.0-dev.20260222.1",
    "@vitest/eslint-plugin": "^1.6.6",
    "bumpp": "^12.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jsdoc": "^65.0.0",
    "eslint-plugin-jsonc": "^3.0.0",
    "eslint-plugin-markdown-preferences": "^0.43.0",
    "eslint-plugin-module-interop": "^0.4.0",
    "eslint-plugin-oxlint": "^1.38.0",
    "eslint-plugin-regexp": "^3.0.0",
    "eslint-plugin-yml": "^3.0.0",
    "gh-changelogen": "^2.0.2",
    "json-schema-to-typescript": "^15.0.4",
    "knip": "^6.45.1",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "pkg-pr-new": "^0.0.93",
    "publint": "^0.3.16",
    "tsdown": "^0.23.7",
    "tsx": "^4.21.0",
    "twoslash-eslint": "^0.3.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite-plugin-eslint4b": "^0.9.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.6.5",
    "vitest": "^5.1.0"
  },
  "prettier": "@kazupon/prettier-config",
  "lint-staged": {
    "*.ts?(x)": [
      "oxfmt --config ./node_modules/@kazupon/prettier-config/index.json --no-error-on-unmatched-pattern",
      "oxlint --config .oxlintrc.json --type-aware --fix",
      "eslint --fix"
    ],
    "*.{js,mjs,cjs}": [
      "oxfmt --config ./node_modules/@kazupon/prettier-config/index.json --no-error-on-unmatched-pattern",
      "oxlint --config .oxlintrc.json --type-aware --fix",
      "eslint --fix"
    ],
    "*.{json,jsonc,json5,md,yml,yaml}": [
      "oxfmt --config ./node_modules/@kazupon/prettier-config/index.json --no-error-on-unmatched-pattern",
      "eslint --fix"
    ]
  }
}
